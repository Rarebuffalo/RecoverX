# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_V1_STR=/api/v1
PROJECT_NAME="RecoverX API"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database (asyncpg for FastAPI runtime, psycopg2 for sync migrations if needed)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=recoverx
POSTGRES_PASSWORD=recoverx_secret
POSTGRES_DB=recoverx_db
DATABASE_URL=postgresql+asyncpg://recoverx:recoverx_secret@localhost:5432/recoverx_db
SYNC_DATABASE_URL=postgresql://recoverx:recoverx_secret@localhost:5432/recoverx_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security / Auth
JWT_SECRET=super_secret_jwt_key_for_development_replace_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Integration (Optional for Phase 1 - Unconfigured by default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Provider Integration (Optional for Phase 1 - Unconfigured by default)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
